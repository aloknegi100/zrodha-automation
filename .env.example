# =====================================================================
#  SETTINGS FILE  --  this is the ONLY file you need to edit.
# =====================================================================
#
#  HOW TO USE:
#   1. Make a copy of this file named exactly ".env"  (command: cp .env.example .env)
#   2. Open ".env" in any text editor and change the values on the right
#      side of the "=" sign.
#   3. Save the file. Do NOT add spaces around the "=".  Correct: MAX_TRADES_PER_DAY=5
#
#  Lines that start with "#" are notes and are ignored by the program.
# =====================================================================


# ---------------------------------------------------------------------
#  1. YOUR ZERODHA LOGIN  (required -- get these from your Kite Connect app)
# ---------------------------------------------------------------------
API_KEY=YOUR_API_KEY
API_SECRET=YOUR_SECRET
ACCESS_TOKEN=YOUR_ACCESS_TOKEN


# ---------------------------------------------------------------------
#  2. SAFETY SWITCH  (the most important setting)
# ---------------------------------------------------------------------
#  true  = PRACTICE MODE. Watches and prints what it WOULD do.
#          No real orders. No money touched. (Keep this until you trust it.)
#  false = LIVE MODE. Places REAL orders with REAL money.
DRY_RUN=true


# ---------------------------------------------------------------------
#  3. RISK RULES  (change the numbers to suit you)
# ---------------------------------------------------------------------

# Biggest a single trade can be, as a % of your capital. Bigger trades are rejected.
MAX_CAPITAL_PER_TRADE_PERCENT=10

# If a position falls this many % below your entry, it is sold immediately.
HARD_STOP_LOSS_PERCENT=10

# Most rupees you allow yourself to lose in one day. After this, trading is
# locked and all positions are closed. (Enter a positive number.)
MAX_DAILY_LOSS=5000

# Most trades allowed per day. After this, no new trades go through.
MAX_TRADES_PER_DAY=5


# ---------------------------------------------------------------------
#  4. AUTO STOP-LOSS  (used when a position has no stop-loss)
# ---------------------------------------------------------------------
# How far below your entry the auto stop-loss is placed, as a %.
DEFAULT_SL_PERCENT=10


# ---------------------------------------------------------------------
#  5. TRAILING STOP  (locks in profit on winning trades)
# ---------------------------------------------------------------------
# Start trailing once a trade is up by this %.
TRAIL_START_PERCENT=2
# Keep the trailing stop this % below the live price.
TRAIL_SL_MOVE_PERCENT=0.5


# ---------------------------------------------------------------------
#  6. END-OF-DAY SQUARE-OFF  (closes everything before the market shuts)
# ---------------------------------------------------------------------
# Time of day to close all positions (24-hour clock). Default 15:15.
SQUARE_OFF_HOUR=15
SQUARE_OFF_MINUTE=15


# ---------------------------------------------------------------------
#  7. HOW OFTEN IT CHECKS  (advanced)
# ---------------------------------------------------------------------
# SECONDS between each risk check. Lower = checks more often (e.g. 30, 15, 10).
# Don't go below ~5 or you may hit Zerodha's API rate limits.
MONITOR_INTERVAL_SECONDS=30


# ---------------------------------------------------------------------
#  8. EMAIL ALERTS  (optional -- leave as-is if you don't use them)
# ---------------------------------------------------------------------
EMAIL_USER=YOUR_EMAIL
EMAIL_PASSWORD=YOUR_PASSWORD
